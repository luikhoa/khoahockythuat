{
  "manifest_version": 3,
  "name": "CyberShield for Teens",
  "version": "1.0",
  "minimum_chrome_version": "109",
  "description": "Làm mờ bình luận độc hại và cảnh báo liên kết đáng ngờ.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "CyberShield",
    "default_popup": "dist/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
